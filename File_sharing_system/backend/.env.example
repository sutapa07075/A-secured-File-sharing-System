# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Postgres (NeonDB) ---
DATABASE_URL=postgres://user:password@your-neon-host/dbname?sslmode=require

# --- Redis (cache, rate limit, queues) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
JWT_ACCESS_SECRET=replace-with-64-byte-random-hex
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Backblaze B2 (S3-compatible API) ---
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your-bucket-name
B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key

# --- Key Management ---
# Replace this with real AWS KMS / HashiCorp Vault calls.
# src/services/kms.js — swap the implementation there
KMS_MASTER_KEY=replace-with-64-byte-random-hex   # openssl rand -hex 32

# --- Misc ---
SHARE_LINK_BASE_URL=http://localhost:5173/s
